---
interface Props {
  id: string;
  kicker?: string;
  title: string;
  subtitle?: string;
}

const { id, kicker, title, subtitle } = Astro.props;
---

<section id={id} class="w-full border-b border-dotted border-neutral-400 dark:border-neutral-700 font-sans">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 border-x-0 sm:border-x border-dotted border-neutral-400 dark:border-neutral-700 py-5 sm:py-7">
    <div class="mb-3 sm:mb-4">
      {kicker && (
        <p class="font-sans text-[10px] sm:text-[11px] uppercase tracking-widest text-neutral-500 mb-0.5 font-medium">
          {kicker}
        </p>
      )}
      <h2 class="font-serif text-2xl sm:text-3xl font-normal tracking-tight text-neutral-950 dark:text-white leading-tight">
        {title}
      </h2>
      {subtitle && (
        <p class="mt-1 text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 max-w-xl leading-snug font-sans">
          {subtitle}
        </p>
      )}
    </div>
    <slot />
  </div>
</section>
