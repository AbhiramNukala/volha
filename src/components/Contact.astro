---
import { Image } from "astro:assets";
import Section from "./Section.astro";
import { personal } from "../data";
import handImg from "../assets/stickers/hand.webp";
import { Copy, Check } from "lucide-astro";
---

<Section
  id="contact"
  number="04"
  kicker="Contact"
  title="Get in Touch"
  subtitle="Feel free to reach out directly regarding full-time roles, engineering opportunities, or technical inquiries."
>
  <!-- Clean, Uncluttered Editorial Contact Spread -->
  <div class="space-y-4 pt-4 border-t border-neutral-200 dark:border-neutral-800 font-sans">
    <div class="space-y-2">
      <div class="flex items-center gap-2 text-xs font-mono text-neutral-500">
        <span class="inline-block size-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="uppercase tracking-widest font-semibold text-[11px]">Direct Email</span>
        <span>·</span>
        <span>Replies within 24 hours</span>
      </div>

      <!-- Large Editorial Email Display with Pointing Hand Graphic -->
      <div class="flex flex-wrap items-center gap-3.5 pt-0.5">
        <!-- Finger Gun Pointer Illustration -->
        <div class="hidden sm:block select-none transform rotate-6 hover:scale-110 transition-transform">
          <Image
            src={handImg}
            alt="Hand pointing towards email"
            width={48}
            height={44}
            class="w-9 sm:w-11 h-auto object-contain filter drop-shadow-sm"
          />
        </div>

        <a
          href={`mailto:${personal.email}`}
          class="font-serif text-2xl xs:text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-normal text-neutral-950 hover:text-orange-600 dark:text-white dark:hover:text-orange-400 underline underline-offset-8 decoration-neutral-300 dark:decoration-neutral-700 hover:decoration-orange-500 transition-all truncate"
        >
          {personal.email}
        </a>

        <button
          type="button"
          data-copy={personal.email}
          aria-label="Copy email address to clipboard"
          class="p-2 rounded-lg border border-neutral-300 dark:border-neutral-700 bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-300 hover:text-orange-600 dark:hover:text-orange-400 transition-colors cursor-pointer shrink-0"
          title="Copy email to clipboard"
        >
          <span class="copy-icon inline-flex items-center">
            <Copy class="size-4 copy-default" />
            <Check class="size-4 text-emerald-500 copy-success hidden" />
          </span>
        </button>
      </div>
    </div>
  </div>
</Section>
