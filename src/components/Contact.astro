---
import Section from "./Section.astro";
import { personal } from "../data";
import { ArrowUpRight, Copy, Check, Dot } from "lucide-astro";
---

<Section
  id="contact"
  number="04"
  kicker="Contact"
  title="Get in Touch"
  subtitle="Feel free to reach out directly regarding full-time roles, engineering opportunities, or technical inquiries."
>
  <div class="flex flex-col lg:flex-row lg:items-baseline justify-between gap-8 pt-4 border-t border-neutral-200 dark:border-neutral-800 font-sans">
    <!-- Email Display (Responsive typography so it NEVER orphans 'm' on mobile!) -->
    <div class="space-y-2">
      <span class="text-[11px] font-mono text-neutral-500 uppercase tracking-widest block font-semibold">
        Direct Email
      </span>

      <div class="flex items-center gap-2.5">
        <a
          href={`mailto:${personal.email}`}
          class="font-serif text-lg xs:text-xl sm:text-2xl md:text-3xl lg:text-4xl font-normal text-neutral-950 hover:text-orange-600 dark:text-white dark:hover:text-orange-400 underline underline-offset-4 decoration-neutral-300 dark:decoration-neutral-700 transition-colors truncate sm:overflow-visible"
        >
          {personal.email}
        </a>

        <button
          type="button"
          data-copy={personal.email}
          class="p-1.5 rounded text-neutral-400 hover:text-orange-600 dark:hover:text-orange-400 transition-colors cursor-pointer shrink-0"
          title="Copy email to clipboard"
        >
          <span class="copy-icon inline-flex items-center">
            <Copy class="size-4 sm:size-4.5 copy-default" />
            <Check class="size-4 sm:size-4.5 text-emerald-500 copy-success hidden" />
          </span>
        </button>
      </div>
    </div>

    <!-- Verified Links & Location -->
    <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4 text-xs font-mono text-neutral-600 dark:text-neutral-400 shrink-0 pt-2 lg:pt-0">
      <div class="flex items-center gap-3">
        <a
          href={personal.github}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1 hover:text-orange-600 dark:hover:text-orange-400 transition-colors"
        >
          <span>GitHub</span>
          <ArrowUpRight class="size-3.5 text-neutral-400" />
        </a>

        <Dot class="size-3 -mx-1 text-neutral-400 dark:text-neutral-600" />

        <a
          href={personal.linkedin}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1 hover:text-orange-600 dark:hover:text-orange-400 transition-colors"
        >
          <span>LinkedIn</span>
          <ArrowUpRight class="size-3.5 text-neutral-400" />
        </a>

        <Dot class="size-3 -mx-1 text-neutral-400 dark:text-neutral-600" />

        <a
          href={personal.npm}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1 hover:text-orange-600 dark:hover:text-orange-400 transition-colors"
        >
          <span>npm</span>
          <ArrowUpRight class="size-3.5 text-neutral-400" />
        </a>
      </div>

      <div class="flex items-center gap-1 text-neutral-500 sm:border-l sm:border-neutral-200 dark:sm:border-neutral-800 sm:pl-3">
        <span>Hyderabad, India</span>
      </div>
    </div>
  </div>
</Section>
