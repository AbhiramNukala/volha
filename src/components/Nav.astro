---
import { Image } from "astro:assets";
import tiger from "../assets/stickers/tiger.webp";
import { personal } from "../data";
import { ArrowRight, Sun, Moon, Command, Copy, Check } from "lucide-astro";

const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "";
const prefix = isHome ? "" : "/";

const navLinks = [
  { label: "Skills", href: `${prefix}#about` },
  { label: "Experience", href: `${prefix}#experience` },
  { label: "Projects", href: `${prefix}#work` },
  { label: "Blog", href: "/blog" },
  { label: "Contact", href: `${prefix}#contact` },
];
---

<header class="sticky top-0 z-40 w-full backdrop-blur-md bg-white/80 dark:bg-[#0c0d11]/80 border-b border-neutral-200/80 dark:border-neutral-800/80 transition-colors">
  <div class="w-full max-w-7xl mx-auto px-6 sm:px-10 lg:px-16 py-3.5 flex items-center justify-between gap-4">
    <!-- Brand / Tiger Mascot -->
    <a href={isHome ? "#top" : "/"} class="flex items-center gap-2.5 group shrink-0">
      <div class="transform -rotate-6 group-hover:rotate-6 group-hover:scale-110 transition-transform duration-300">
        <Image
          src={tiger}
          alt="Tiger mascot"
          width={32}
          height={32}
          quality={90}
          loading="eager"
          decoding="async"
          class="w-7 h-auto aspect-square object-contain select-none filter drop-shadow-[0_2px_4px_rgba(0,0,0,0.12)]"
        />
      </div>
      <div>
        <span class="font-serif text-lg text-neutral-950 dark:text-white font-normal group-hover:text-orange-700 dark:group-hover:text-orange-400 transition-colors tracking-tight">
          {personal.name}
        </span>
      </div>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden md:flex items-center gap-1 text-xs font-sans text-neutral-600 dark:text-neutral-400" aria-label="Main navigation">
      {navLinks.map((link) => {
        const isActive = link.href === "/blog" && Astro.url.pathname.startsWith("/blog");
        return (
          <a
            href={link.href}
            class={`nav-anchor px-3 py-1.5 rounded-md transition-colors ${
              isActive
                ? "text-orange-700 dark:text-orange-400 font-medium bg-neutral-100/70 dark:bg-neutral-900/70"
                : "hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900"
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Desktop Controls -->
    <div class="hidden sm:flex items-center gap-2">
      <!-- Menu Command Palette Trigger Button -->
      <button
        type="button"
        data-command-trigger
        aria-label="Open Command Palette (Cmd + K)"
        class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-md border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 text-neutral-700 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white hover:border-neutral-400 dark:hover:border-neutral-600 text-xs font-mono cursor-pointer transition-colors"
        title="Open Command Palette (Cmd + K)"
      >
        <Command class="size-3 text-neutral-400" />
        <span>Menu</span>
        <kbd class="text-[9px] px-1 py-0.2 rounded bg-neutral-200 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400">⌘K</kbd>
      </button>

      <button
        type="button"
        data-copy={personal.email}
        aria-label="Copy Email Address"
        class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-md border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 text-neutral-700 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white text-xs font-sans cursor-pointer transition-colors group"
        title="Copy Email Address"
      >
        <span class="copy-icon inline-flex items-center text-neutral-400 group-hover:text-orange-500">
          <Copy class="size-3 copy-default" />
          <Check class="size-3 text-emerald-500 copy-success hidden" />
        </span>
        <span class="text-xs">Email</span>
      </button>

      <button
        id="theme-toggle-desktop"
        type="button"
        aria-label="Toggle theme"
        class="size-8 flex items-center justify-center rounded-md text-neutral-500 hover:text-neutral-950 dark:text-neutral-400 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors cursor-pointer"
      >
        <Sun class="size-3.5 hidden dark:block" />
        <Moon class="size-3.5 block dark:hidden" />
      </button>
    </div>

    <!-- Mobile Header Controls -->
    <div class="flex sm:hidden items-center gap-2">
      <button
        type="button"
        data-command-trigger
        aria-label="Open command palette"
        class="size-9 flex items-center justify-center rounded-md border border-neutral-200 dark:border-neutral-800 text-neutral-700 dark:text-neutral-300 cursor-pointer"
      >
        <Command class="size-4" />
      </button>

      <button
        id="theme-toggle-mobile"
        type="button"
        aria-label="Toggle theme"
        class="size-9 flex items-center justify-center rounded-md border border-neutral-200 dark:border-neutral-800 text-neutral-600 dark:text-neutral-400 cursor-pointer"
      >
        <Sun class="size-4 hidden dark:block" />
        <Moon class="size-4 block dark:hidden" />
      </button>

      <button
        id="mobile-nav-toggle"
        type="button"
        aria-label="Toggle navigation"
        aria-expanded="false"
        aria-controls="mobile-nav-menu"
        class="size-9 flex items-center justify-center rounded-md border border-neutral-200 dark:border-neutral-800 text-neutral-700 dark:text-neutral-300 cursor-pointer"
      >
        <svg id="menu-icon-open" class="size-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="size-4.5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-nav-menu"
    class="sm:hidden hidden flex-col px-6 pt-2 pb-4 border-t border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0c0d11] text-xs font-sans space-y-1"
  >
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="mobile-nav-link flex items-center justify-between py-2.5 px-3 rounded hover:bg-neutral-100 dark:hover:bg-neutral-900 text-neutral-700 dark:text-neutral-300 transition-colors"
      >
        <span>{link.label}</span>
        <ArrowRight class="size-3 text-neutral-500 dark:text-neutral-400" />
      </a>
    ))}

    <div class="pt-2 border-t border-neutral-200 dark:border-neutral-800 flex items-center gap-2">
      <button
        type="button"
        data-copy={personal.email}
        class="flex-1 py-2.5 text-center rounded border border-neutral-200 dark:border-neutral-800 text-neutral-700 dark:text-neutral-300 text-xs"
      >
        Copy Email
      </button>
    </div>
  </div>
</header>
