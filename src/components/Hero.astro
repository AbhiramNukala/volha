---
import { Image } from "astro:assets";
import einsteinImg from "../assets/stickers/einstein.webp";
import { personal } from "../data";
import { ArrowDown, ArrowRight, Copy, Check } from "lucide-astro";
---

<section id="top" class="w-full pt-6 sm:pt-8 pb-6 sm:pb-8 font-sans">
  <div class="w-full max-w-7xl mx-auto px-6 sm:px-10 lg:px-16">
    <!-- Wide Open Editorial Hero Layout -->
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-14 items-center">
      <!-- Left Column: Headline, Summary & Navigation Links -->
      <div class="lg:col-span-7 xl:col-span-8 space-y-5">
        <h1 class="font-serif text-4xl sm:text-6xl md:text-7xl font-normal text-neutral-950 dark:text-white leading-[1.05] tracking-tight">
          Building{" "}
          <span class="italic text-orange-700 dark:text-orange-400 aurora-text-gradient">
            React.js
          </span>{" "}
          web apps &amp;{" "}
          <span class="italic text-orange-700 dark:text-orange-400 aurora-text-gradient">
            React Native
          </span>{" "}
          mobile systems.
        </h1>

        <p class="text-base sm:text-lg text-neutral-700 dark:text-neutral-300 leading-relaxed font-sans max-w-2xl">
          {personal.summary}
        </p>

        <!-- Navigation & Quick Links -->
        <div class="pt-4 flex flex-wrap items-center gap-x-5 gap-y-2.5 text-xs sm:text-sm font-sans border-t border-neutral-200/80 dark:border-neutral-800/80">
          <a
            href="#experience"
            class="inline-flex items-center gap-1.5 py-1 font-medium text-neutral-950 hover:text-orange-700 dark:text-white dark:hover:text-orange-400 transition-colors group"
          >
            <span>Experience</span>
            <ArrowDown class="size-4 text-neutral-500 dark:text-neutral-400 group-hover:text-orange-700 dark:group-hover:text-orange-400 group-hover:translate-y-0.5 transition-all" stroke-width={2.25} />
          </a>

          <a
            href="#work"
            class="inline-flex items-center gap-1.5 py-1 font-medium text-neutral-950 hover:text-orange-700 dark:text-white dark:hover:text-orange-400 transition-colors group"
          >
            <span>Projects</span>
            <ArrowDown class="size-4 text-neutral-500 dark:text-neutral-400 group-hover:text-orange-700 dark:group-hover:text-orange-400 group-hover:translate-y-0.5 transition-all" stroke-width={2.25} />
          </a>

          <a
            href="/blog"
            class="inline-flex items-center gap-1.5 py-1 font-medium text-neutral-950 hover:text-orange-700 dark:text-white dark:hover:text-orange-400 transition-colors group"
          >
            <span>Blog</span>
            <ArrowRight class="size-4 text-neutral-500 dark:text-neutral-400 group-hover:text-orange-700 dark:group-hover:text-orange-400 group-hover:translate-x-0.5 transition-all" stroke-width={2.25} />
          </a>

          <a
            href="#contact"
            class="inline-flex items-center gap-1.5 py-1 font-medium text-neutral-950 hover:text-orange-700 dark:text-white dark:hover:text-orange-400 transition-colors group"
          >
            <span>Contact</span>
            <ArrowDown class="size-4 text-neutral-500 dark:text-neutral-400 group-hover:text-orange-700 dark:group-hover:text-orange-400 group-hover:translate-y-0.5 transition-all" stroke-width={2.25} />
          </a>

          <button
            type="button"
            data-copy={personal.email}
            class="inline-flex items-center gap-1.5 py-1 text-neutral-700 hover:text-orange-700 dark:text-neutral-300 dark:hover:text-orange-400 transition-colors cursor-pointer group"
            title="Copy email to clipboard"
          >
            <span class="font-mono text-xs">{personal.email}</span>
            <span class="copy-icon inline-flex items-center text-neutral-400 group-hover:text-orange-500">
              <Copy class="size-3.5 copy-default" />
              <Check class="size-3.5 text-emerald-500 copy-success hidden" />
            </span>
          </button>
        </div>
      </div>

      <!-- Right Column: Einstein Artwork Centered with Witty Note -->
      <div class="lg:col-span-5 xl:col-span-4 flex flex-col items-center justify-center pt-2 lg:pt-0">
        <div class="flex flex-col items-center justify-center text-center space-y-3 group select-none w-full">
          <div class="relative flex justify-center items-center w-full">
            <!-- Warm Aurora Halo Behind Artwork -->
            <div class="absolute w-36 sm:w-44 h-36 sm:h-44 rounded-full bg-gradient-to-tr from-orange-500/20 via-amber-400/15 to-transparent blur-2xl pointer-events-none -z-10 animate-pulse" style="animation-duration: 6s;"></div>
            <Image
              src={einsteinImg}
              alt="Albert Einstein sticking his tongue out"
              width={200}
              height={210}
              quality={75}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="w-32 sm:w-40 h-auto object-contain filter drop-shadow-[0_8px_16px_rgba(0,0,0,0.14)] dark:drop-shadow-[0_8px_20px_rgba(0,0,0,0.6)] transform hover:scale-105 transition-transform duration-300"
            />
          </div>

          <div class="w-full max-w-xs mx-auto space-y-1 font-mono text-xs">
            <p class="italic text-neutral-800 dark:text-neutral-200 leading-relaxed text-left text-[11px] sm:text-xs">
              “If your code compiles on the first try, don't celebrate. Something is deeply wrong.”
            </p>
            <p class="text-[10px] text-orange-700 dark:text-orange-400 uppercase tracking-widest font-semibold text-right">
              — THEORY OF RELATIVE DEBUGGING
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
