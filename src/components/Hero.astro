---
import { Image } from "astro:assets";
import { personal, exp } from "../data";
import StickerComponent from "./Sticker.astro";
import { ArrowDown, ArrowUpRight, ArrowRight, Copy, Check } from "lucide-astro";
---

<section id="top" class="w-full pt-8 sm:pt-14 pb-12 sm:pb-16 font-sans">
  <div class="w-full max-w-7xl mx-auto px-6 sm:px-10 lg:px-16 space-y-8 sm:space-y-12">
    <!-- Top Identity Marker -->
    <div class="flex items-center justify-between text-xs font-mono text-neutral-500 pb-3 border-b border-neutral-200/80 dark:border-neutral-800/80">
      <div class="flex items-center gap-2">
        <span class="inline-block size-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="text-neutral-900 dark:text-neutral-200 uppercase tracking-widest font-semibold">
          {personal.name}
        </span>
        <span>·</span>
        <span>{personal.location}</span>
      </div>

      <div class="text-[11px] hidden sm:flex items-center gap-2">
        <span class="text-orange-600 dark:text-orange-400 font-semibold">React.js</span>
        <span>·</span>
        <span class="text-orange-600 dark:text-orange-400 font-semibold">React Native</span>
        <span>·</span>
        <span>C++ (JSI)</span>
      </div>
    </div>

    <!-- Wide Open Editorial Hero Layout (Zero generic cards!) -->
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-14 items-start">
      <!-- Left Column: Typography, Summary & Metrics -->
      <div class="lg:col-span-7 xl:col-span-8 space-y-6">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 font-mono text-xs text-neutral-600 dark:text-neutral-400">
            <span class="text-orange-600 dark:text-orange-400 font-bold">●</span>
            <span class="uppercase tracking-wider font-semibold text-neutral-900 dark:text-neutral-200">
              {exp.yearsPlus} Experience (May 2024 – Present)
            </span>
          </div>

          <h1 class="font-serif text-4xl sm:text-6xl md:text-7xl font-normal text-neutral-950 dark:text-white leading-[1.05] tracking-tight">
            Building{" "}
            <span class="italic text-orange-600 dark:text-orange-400">
              React.js
            </span>{" "}
            web apps &amp;{" "}
            <span class="italic text-orange-600 dark:text-orange-400">
              React Native
            </span>{" "}
            mobile systems.
          </h1>
        </div>

        <p class="text-base sm:text-lg text-neutral-700 dark:text-neutral-300 leading-relaxed font-sans max-w-2xl">
          {personal.summary}
        </p>

        <!-- Open Editorial Metric Accents (No Card Boxes!) -->
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3 pt-2 text-xs font-mono text-neutral-600 dark:text-neutral-400 border-t border-neutral-200/80 dark:border-neutral-800/80">
          <div class="flex items-center gap-2 group">
            <StickerComponent name="exclamation" size="xs" interactive={true} />
            <span><strong class="text-neutral-950 dark:text-white">4h → 25m</strong> Store Releases</span>
          </div>

          <span class="text-neutral-300 dark:text-neutral-700 select-none hidden sm:inline">/</span>

          <div class="flex items-center gap-2 group">
            <StickerComponent name="knight" size="xs" interactive={true} />
            <span><strong class="text-neutral-950 dark:text-white">C++ Nitro</strong> Modules (JSI)</span>
          </div>

          <span class="text-neutral-300 dark:text-neutral-700 select-none hidden sm:inline">/</span>

          <div class="flex items-center gap-2 group">
            <StickerComponent name="dove" size="xs" interactive={true} />
            <span><strong class="text-neutral-950 dark:text-white">≥99.5%</strong> Crash-Free</span>
          </div>

          <span class="text-neutral-300 dark:text-neutral-700 select-none hidden sm:inline">/</span>

          <div class="flex items-center gap-2 group">
            <StickerComponent name="fire" size="xs" interactive={true} />
            <span><strong class="text-neutral-950 dark:text-white">60 FPS</strong> Hermes Tuning</span>
          </div>
        </div>

        <!-- Navigation & Quick Links with Pointing Hand Sticker -->
        <div class="pt-5 flex flex-wrap items-center gap-x-5 gap-y-3 text-xs sm:text-sm font-sans border-t border-neutral-200/80 dark:border-neutral-800/80">
          <div class="flex items-center gap-2">
            <div class="transform rotate-6 -mr-1">
              <StickerComponent name="hand" size="xs" interactive={true} />
            </div>
            <a
              href="#experience"
              class="inline-flex items-center gap-1.5 font-medium text-neutral-950 hover:text-orange-600 dark:text-white dark:hover:text-orange-400 transition-colors group"
            >
              <span>Experience</span>
              <ArrowDown class="size-4 text-neutral-500 dark:text-neutral-400 group-hover:text-orange-600 dark:group-hover:text-orange-400 group-hover:translate-y-0.5 transition-all" stroke-width={2.25} />
            </a>
          </div>

          <a
            href="#work"
            class="inline-flex items-center gap-1.5 font-medium text-neutral-950 hover:text-orange-600 dark:text-white dark:hover:text-orange-400 transition-colors group"
          >
            <span>Projects</span>
            <ArrowDown class="size-4 text-neutral-500 dark:text-neutral-400 group-hover:text-orange-600 dark:group-hover:text-orange-400 group-hover:translate-y-0.5 transition-all" stroke-width={2.25} />
          </a>

          <a
            href="#contact"
            class="inline-flex items-center gap-1.5 font-medium text-neutral-950 hover:text-orange-600 dark:text-white dark:hover:text-orange-400 transition-colors group"
          >
            <span>Contact</span>
            <ArrowDown class="size-4 text-neutral-500 dark:text-neutral-400 group-hover:text-orange-600 dark:group-hover:text-orange-400 group-hover:translate-y-0.5 transition-all" stroke-width={2.25} />
          </a>

          <button
            type="button"
            data-copy={personal.email}
            class="inline-flex items-center gap-1.5 text-neutral-700 hover:text-orange-600 dark:text-neutral-300 dark:hover:text-orange-400 transition-colors cursor-pointer group"
            title="Copy email to clipboard"
          >
            <span class="font-mono text-xs">{personal.email}</span>
            <span class="copy-icon inline-flex items-center text-neutral-400 group-hover:text-orange-500">
              <Copy class="size-3.5 copy-default" />
              <Check class="size-3.5 text-emerald-500 copy-success hidden" />
            </span>
          </button>

          <span class="text-neutral-300 dark:text-neutral-700 select-none hidden sm:inline">·</span>

          <div class="flex items-center gap-3 font-mono text-xs">
            <a
              href={personal.github}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-1 text-neutral-600 hover:text-orange-600 dark:text-neutral-400 dark:hover:text-orange-400 transition-colors group"
            >
              <span>GitHub</span>
              <ArrowUpRight class="size-3.5 text-neutral-400 group-hover:text-orange-500 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all" stroke-width={2} />
            </a>

            <a
              href={personal.linkedin}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-1 text-neutral-600 hover:text-orange-600 dark:text-neutral-400 dark:hover:text-orange-400 transition-colors group"
            >
              <span>LinkedIn</span>
              <ArrowUpRight class="size-3.5 text-neutral-400 group-hover:text-orange-500 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all" stroke-width={2} />
            </a>

            <a
              href={personal.npm}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-1 text-neutral-600 hover:text-orange-600 dark:text-neutral-400 dark:hover:text-orange-400 transition-colors group"
            >
              <span>npm</span>
              <ArrowUpRight class="size-3.5 text-neutral-400 group-hover:text-orange-500 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all" stroke-width={2} />
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Open Editorial Sticker Spread & Directory (Zero cards!) -->
      <div class="lg:col-span-5 xl:col-span-4 flex flex-col justify-between space-y-8 pt-2">
        <!-- Open Sticker Artwork Cluster (Organic, freeform placement on the page) -->
        <div class="relative py-2 select-none">
          <!-- Top metadata row -->
          <div class="flex items-baseline justify-between font-mono text-xs text-neutral-500 pb-2 border-b border-neutral-200/80 dark:border-neutral-800/80">
            <span class="uppercase tracking-widest text-[10px] font-semibold text-neutral-400">
              Identity & Emblems
            </span>
            <span class="text-neutral-700 dark:text-neutral-300 font-semibold">
              Hyderabad · IST (UTC+05:30)
            </span>
          </div>

          <!-- Free-floating layered stickers (No card frame!) -->
          <div class="relative h-48 sm:h-56 my-2 flex items-center justify-center">
            <!-- Moon sticker (floating top-right) -->
            <div class="absolute right-0 -top-1 opacity-40 dark:opacity-25 pointer-events-none">
              <StickerComponent name="moon" size="custom" class="w-24 h-auto" interactive={false} />
            </div>

            <!-- Statue sticker (left background) -->
            <div class="absolute left-2 top-2 opacity-85 hover:opacity-100 transition-opacity">
              <StickerComponent name="statue" size="custom" class="w-24 sm:w-28 h-auto" interactive={true} rotation={-8} />
            </div>

            <!-- Starry Night strip (top horizontal ribbon) -->
            <div class="absolute -top-1 left-20 z-10 hover:z-30">
              <StickerComponent name="starryNight" size="custom" class="w-36 sm:w-44 h-auto" interactive={true} rotation={2} />
            </div>

            <!-- Centerpiece: Roaring Bengal Tiger Mascot with die-cut shadow -->
            <div class="relative z-20 hover:z-30">
              <StickerComponent name="tiger" size="custom" class="w-32 sm:w-36 h-auto" interactive={true} rotation={-3} />
            </div>

            <!-- Tactical Knight sticker (right foreground) -->
            <div class="absolute right-3 bottom-0 z-20 hover:z-30">
              <StickerComponent name="knight" size="custom" class="w-16 sm:w-20 h-auto" interactive={true} rotation={8} />
            </div>

            <!-- Crown sticker (floating top right of tiger) -->
            <div class="absolute right-14 top-4 z-10 hover:z-30">
              <StickerComponent name="crown" size="custom" class="w-14 h-auto" interactive={true} rotation={-12} />
            </div>
          </div>
        </div>

        <!-- High-Visibility Editorial Index (Card-free list separated by hairlines) -->
        <div class="space-y-1 font-mono text-xs sm:text-sm border-t border-neutral-200/80 dark:border-neutral-800/80 pt-3">
          <span class="text-[10px] uppercase tracking-widest text-neutral-400 block mb-2 font-semibold">
            Index
          </span>
          <a
            href="#about"
            class="group flex items-center justify-between py-2 border-b border-neutral-100 dark:border-neutral-800/60 text-neutral-700 hover:text-orange-600 dark:text-neutral-300 dark:hover:text-orange-400 transition-colors"
          >
            <span class="font-medium">01 / Technical Skills</span>
            <ArrowRight class="size-4 text-neutral-400 group-hover:text-orange-600 dark:group-hover:text-orange-400 group-hover:translate-x-1 transition-all shrink-0" stroke-width={2} />
          </a>
          <a
            href="#experience"
            class="group flex items-center justify-between py-2 border-b border-neutral-100 dark:border-neutral-800/60 text-neutral-700 hover:text-orange-600 dark:text-neutral-300 dark:hover:text-orange-400 transition-colors"
          >
            <span class="font-medium">02 / Experience</span>
            <ArrowRight class="size-4 text-neutral-400 group-hover:text-orange-600 dark:group-hover:text-orange-400 group-hover:translate-x-1 transition-all shrink-0" stroke-width={2} />
          </a>
          <a
            href="#work"
            class="group flex items-center justify-between py-2 border-b border-neutral-100 dark:border-neutral-800/60 text-neutral-700 hover:text-orange-600 dark:text-neutral-300 dark:hover:text-orange-400 transition-colors"
          >
            <span class="font-medium">03 / Selected Projects</span>
            <ArrowRight class="size-4 text-neutral-400 group-hover:text-orange-600 dark:group-hover:text-orange-400 group-hover:translate-x-1 transition-all shrink-0" stroke-width={2} />
          </a>
          <a
            href="#contact"
            class="group flex items-center justify-between py-2 text-neutral-700 hover:text-orange-600 dark:text-neutral-300 dark:hover:text-orange-400 transition-colors"
          >
            <span class="font-medium">04 / Contact</span>
            <ArrowRight class="size-4 text-neutral-400 group-hover:text-orange-600 dark:group-hover:text-orange-400 group-hover:translate-x-1 transition-all shrink-0" stroke-width={2} />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
