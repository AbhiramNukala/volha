---
import { Image } from "astro:assets";
import tiger from "../assets/tiger.webp";
import { links } from "../data";
import { ArrowDown, ArrowUpRight, Dot, Copy, Check } from "lucide-astro";
---

<section
    id="top"
    class="w-full border-b border-dotted border-neutral-400 dark:border-neutral-700 font-sans"
>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 border-x-0 sm:border-x border-dotted border-neutral-400 dark:border-neutral-700 pt-4 sm:pt-6 pb-5 sm:pb-7">
        <div class="space-y-3.5 sm:space-y-4">
        <!-- Subtitle / Identity Line -->
        <div class="flex flex-wrap items-center gap-1 text-xs font-sans text-neutral-500 dark:text-neutral-400">
            <span class="uppercase tracking-widest font-medium text-neutral-900 dark:text-neutral-200">
                Nukala Abhiram
            </span>
            <Dot class="size-4 -mx-1.5 text-neutral-400 dark:text-neutral-600 shrink-0" />
            <span class="font-serif italic text-sm sm:text-base text-neutral-800 dark:text-neutral-300">
                Software Engineer
            </span>
            <Dot class="size-4 -mx-1.5 text-neutral-400 dark:text-neutral-600 shrink-0" />
            <span class="text-neutral-500 text-[11px]">Hyderabad, IN</span>
        </div>

        <!-- Editorial Headline with Tiger Tilted 30deg Behind "Native" -->
        <h1 class="font-serif text-3xl sm:text-5xl md:text-6xl font-normal tracking-tight text-neutral-950 dark:text-white leading-[1.08]">
            Engineering{" "}
            <span class="italic text-orange-600 dark:text-orange-400 font-serif">
                React
            </span>{" "}
            &amp;{" "}
            <span class="inline-block whitespace-nowrap">
                <span class="italic text-orange-600 dark:text-orange-400 font-serif">
                    React
                </span>{" "}
                <span class="relative inline-block">
                    <Image
                        src={tiger}
                        alt=""
                        width={260}
                        height={180}
                        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-28 sm:w-40 md:w-48 h-auto aspect-[260/180] object-contain rotate-10 pointer-events-none select-none opacity-85 -z-10 filter drop-shadow-[0_8px_16px_rgba(0,0,0,0.12)] dark:drop-shadow-[0_8px_16px_rgba(0,0,0,0.85)]"
                        loading="eager"
                        fetchpriority="high"
                        aria-hidden="true"
                    />
                    <span class="relative z-10 italic text-orange-600 dark:text-orange-400 font-serif">
                        Native
                    </span>
                </span>
            </span>{" "}
            experiences that ship and scale.
        </h1>

        <!-- Narrative in Alata font -->
        <p class="font-sans text-neutral-700 dark:text-neutral-400 text-xs sm:text-sm md:text-base leading-snug max-w-2xl">
            Software engineer with 2.7 years of production experience based in
            Hyderabad, India. I build web dashboards, store releases and mobile
            payments in TypeScript, plus native modules in C++ with JSI when
            performance counts.
        </p>

        <!-- Quick Actions & Links with Lucide Arrows -->
        <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs sm:text-sm font-sans pt-0.5">
            <a
                href="#work"
                class="inline-flex items-center gap-1 font-medium text-neutral-950 hover:text-orange-600 dark:text-white dark:hover:text-orange-400 transition-colors group"
            >
                <span>View work History</span>
                <ArrowDown class="size-3 text-neutral-400 dark:text-neutral-500 group-hover:text-orange-600 dark:group-hover:text-orange-400 group-hover:translate-y-0.5 transition-all" />
            </a>

            <button
                type="button"
                data-copy={links.email}
                class="inline-flex items-center gap-1.5 text-neutral-700 hover:text-orange-600 dark:text-neutral-400 dark:hover:text-orange-400 transition-colors cursor-pointer group"
                title="Copy email to clipboard"
                aria-label="Copy email address"
            >
                <span class="text-xs">{links.email}</span>
                <span class="copy-icon text-neutral-400 group-hover:text-orange-600 dark:text-neutral-500 dark:group-hover:text-orange-400 transition-colors inline-flex items-center">
                    <Copy class="size-3 copy-default" />
                    <Check class="size-3 text-emerald-500 dark:text-emerald-400 copy-success hidden" />
                </span>
            </button>

            <Dot class="size-4 -mx-1.5 text-neutral-400 dark:text-neutral-600 hidden sm:inline-block shrink-0" />

            <a
                href={links.github}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-0.5 text-neutral-700 hover:text-orange-600 dark:text-neutral-400 dark:hover:text-orange-400 transition-colors group"
            >
                <span>GitHub</span>
                <ArrowUpRight class="size-3 text-neutral-400 dark:text-neutral-500 group-hover:text-orange-600 dark:group-hover:text-orange-400 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all" />
            </a>
            <Dot class="size-4 -mx-1.5 text-neutral-400 dark:text-neutral-600 shrink-0" />
            <a
                href={links.linkedin}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-0.5 text-neutral-700 hover:text-orange-600 dark:text-neutral-400 dark:hover:text-orange-400 transition-colors group"
            >
                <span>LinkedIn</span>
                <ArrowUpRight class="size-3 text-neutral-400 dark:text-neutral-500 group-hover:text-orange-600 dark:group-hover:text-orange-400 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all" />
            </a>
            <Dot class="size-4 -mx-1.5 text-neutral-400 dark:text-neutral-600 shrink-0" />
            <a
                href={links.npm}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-0.5 text-neutral-700 hover:text-orange-600 dark:text-neutral-400 dark:hover:text-orange-400 transition-colors group"
            >
                <span>npm</span>
                <ArrowUpRight class="size-3 text-neutral-400 dark:text-neutral-500 group-hover:text-orange-600 dark:group-hover:text-orange-400 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all" />
            </a>
        </div>
    </div>
    </div>
</section>
