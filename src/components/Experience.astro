---
import Section from "./Section.astro";
import { experience } from "../data";
import { Dot, ArrowRight } from "lucide-astro";
---

<Section id="experience" kicker="Experience" title="Work History">
    <div class="space-y-6 font-sans">
        {experience.map((job) => (
            <div class="space-y-3">
                <!-- Job Header -->
                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 pb-1.5 border-b border-dotted border-neutral-400 dark:border-neutral-700">
                    <div>
                        <h3 class="font-serif text-lg sm:text-xl font-normal text-neutral-950 dark:text-white tracking-tight">
                            {job.company}
                        </h3>
                        <p class="font-sans text-xs text-neutral-800 dark:text-neutral-300 mt-0.5">
                            {job.role}
                        </p>
                    </div>
                    <div class="text-[11px] sm:text-xs text-neutral-500 sm:text-right mt-0.5 sm:mt-0 flex items-center sm:justify-end gap-0.5">
                        <span>{job.period}</span>
                        <Dot class="size-3.5 -mx-1 text-neutral-400 dark:text-neutral-600 shrink-0" />
                        <span>{job.place}</span>
                    </div>
                </div>

                <!-- Job Projects (Pure editorial flow, no cards/boxes) -->
                <div class="space-y-3 sm:pl-1">
                    {job.projects.map((p) => (
                        <div class="space-y-1">
                            <div class="flex flex-wrap items-baseline gap-1.5">
                                <h4 class="font-sans text-xs sm:text-sm font-semibold text-neutral-900 dark:text-neutral-200">
                                    {p.name}
                                </h4>
                                <span class="text-[11px] sm:text-xs text-neutral-500">
                                    / {p.meta}
                                </span>
                            </div>
                            <ul class="space-y-1 text-xs sm:text-sm text-neutral-700 dark:text-neutral-400 leading-snug font-sans">
                                {p.points.map((pt) => (
                                    <li class="flex items-start gap-2">
                                        <ArrowRight class="size-3.5 -mx-1 text-neutral-400 dark:text-neutral-600 shrink-0 mt-1" />
                                        <span>{pt}</span>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))}
                </div>
            </div>
        ))}
    </div>
</Section>
