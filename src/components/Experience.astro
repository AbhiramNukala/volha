---
import Section from "./Section.astro";
import { experience } from "../data";
import { ArrowRight, Dot } from "lucide-astro";
---

<Section
  id="experience"
  number="02"
  kicker="Work History"
  title="Professional Experience"
  subtitle="Production engineering roles focused on React.js web apps and React Native iOS and Android systems."
>
  <!-- Card-free Open Editorial Timeline -->
  <div class="space-y-10 sm:space-y-12 font-sans">
    {experience.map((job) => (
      <div class="grid lg:grid-cols-12 gap-6 lg:gap-14 pt-5 border-t border-neutral-200 dark:border-neutral-800 first:border-t-0 first:pt-0">
        <!-- Left Column: Company & Role Information -->
        <div class="lg:col-span-4 space-y-1.5 lg:sticky lg:top-20 self-start">
          <h3 class="font-serif text-3xl sm:text-4xl font-normal text-neutral-950 dark:text-white tracking-tight">
            {job.company}
          </h3>

          <p class="text-sm font-medium text-neutral-800 dark:text-neutral-200">
            {job.role}
          </p>

          <div class="flex flex-wrap items-center gap-1 font-mono text-xs text-neutral-500 pt-0.5">
            <span>{job.period}</span>
            <Dot class="size-3 -mx-1 text-neutral-400 dark:text-neutral-600" />
            <span>{job.place}</span>
          </div>
        </div>

        <!-- Right Column: Projects & Bulleted Achievements -->
        <div class="lg:col-span-8 space-y-8">
          {job.projects.map((project) => (
            <div class="space-y-2.5 pb-5 sm:pb-6 border-b border-neutral-200/80 dark:border-neutral-800/80 last:border-b-0 last:pb-0">
              <!-- Project Header -->
              <div class="space-y-1">
                <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-2">
                  <h4 class="font-semibold text-base sm:text-lg text-neutral-950 dark:text-white shrink-0 tracking-tight">
                    {project.name}
                  </h4>
                  <span class="text-xs font-mono text-neutral-500">
                    / {project.meta}
                  </span>
                </div>

                <!-- Tech Stack tags with clean spacing -->
                <div class="flex flex-wrap items-center gap-x-1.5 gap-y-0.5 font-mono text-[11px] text-neutral-500 pt-0.5">
                  {project.tech.map((t, idx) => (
                    <>
                      <span>{t}</span>
                      {idx < project.tech.length - 1 && <span class="text-neutral-300 dark:text-neutral-700 select-none">·</span>}
                    </>
                  ))}
                </div>
              </div>

              <!-- Bullet Points with breathing room -->
              <ul class="space-y-2 text-xs sm:text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed pt-0.5">
                {project.points.map((pt) => (
                  <li class="flex items-start gap-2.5">
                    <ArrowRight class="size-3.5 text-neutral-400 dark:text-neutral-500 shrink-0 mt-1" />
                    <span>{pt}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</Section>
