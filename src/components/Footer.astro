---
import { Image } from "astro:assets";
import tiger from "../assets/stickers/tiger.webp";
import { Github, Linkedin, Package } from "lucide-astro";
import { personal } from "../data";
---

<footer class="w-full border-t border-neutral-200/80 dark:border-neutral-800/80 font-sans text-xs text-neutral-500 bg-transparent py-2.5 sm:py-3">
  <div class="w-full max-w-7xl mx-auto px-4 sm:px-10 lg:px-16 flex items-center justify-between gap-2">
    <!-- Left: Cute Tiger Sticker + Name in a single line -->
    <div class="flex items-center gap-1.5 sm:gap-2 min-w-0 select-none shrink">
      <div class="transform -rotate-6 hover:rotate-12 hover:scale-110 active:scale-95 transition-transform duration-300 cursor-pointer shrink-0">
        <Image
          src={tiger}
          alt="Tiger mascot"
          width={24}
          height={24}
          quality={90}
          loading="lazy"
          decoding="async"
          class="w-5 h-auto aspect-square object-contain filter drop-shadow-xs"
        />
      </div>
      <span class="font-serif text-xs sm:text-sm text-neutral-950 dark:text-white font-normal tracking-tight truncate">
        {personal.name}
      </span>
      <span class="text-neutral-300 dark:text-neutral-700 select-none shrink-0">·</span>
      <span class="text-[10px] sm:text-[11px] font-mono text-neutral-400 shrink-0">
        Hyd, IN
      </span>
    </div>

    <!-- Right: Icons on mobile (< md), text links on mid & large (md+) -->
    <div class="flex items-center shrink-0">
      <!-- Mobile (< md): Cute Compact Icons -->
      <div class="flex md:hidden items-center gap-1 font-mono">
        <a
          href={personal.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub Profile"
          class="p-1.5 rounded-md text-neutral-600 hover:text-orange-600 dark:text-neutral-400 dark:hover:text-orange-400 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
        >
          <Github class="size-3.5" />
        </a>
        <a
          href={personal.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn Profile"
          class="p-1.5 rounded-md text-neutral-600 hover:text-orange-600 dark:text-neutral-400 dark:hover:text-orange-400 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
        >
          <Linkedin class="size-3.5" />
        </a>
        <a
          href={personal.npm}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="npm Packages"
          class="p-1.5 rounded-md text-neutral-600 hover:text-orange-600 dark:text-neutral-400 dark:hover:text-orange-400 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
        >
          <Package class="size-3.5" />
        </a>
      </div>

      <!-- Mid & Large (md+): Text Links -->
      <div class="hidden md:flex items-center gap-3.5 font-mono text-xs">
        <a
          href={personal.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub Profile"
          class="text-neutral-600 hover:text-orange-600 dark:text-neutral-400 dark:hover:text-orange-400 transition-colors"
        >
          GitHub
        </a>
        <span class="text-neutral-300 dark:text-neutral-700 select-none">·</span>
        <a
          href={personal.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn Profile"
          class="text-neutral-600 hover:text-orange-600 dark:text-neutral-400 dark:hover:text-orange-400 transition-colors"
        >
          LinkedIn
        </a>
        <span class="text-neutral-300 dark:text-neutral-700 select-none">·</span>
        <a
          href={personal.npm}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="npm Packages"
          class="text-neutral-600 hover:text-orange-600 dark:text-neutral-400 dark:hover:text-orange-400 transition-colors"
        >
          npm
        </a>
      </div>
    </div>
  </div>
</footer>
