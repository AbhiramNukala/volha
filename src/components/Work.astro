---
import { Image } from "astro:assets";
import Section from "./Section.astro";
import { projects } from "../data";
import knightImg from "../assets/stickers/knight.webp";
import moonImg from "../assets/stickers/moon.webp";
import { ArrowUpRight, Copy, Check } from "lucide-astro";

const projectVisuals: Record<string, { image: ImageMetadata; alt: string }> = {
  "rn-udpb": { image: knightImg, alt: "Tactical Knight illustration representing C++ JSI Native Bridge" },
  "Cosmos": { image: moonImg, alt: "Halftone Moon illustration representing decentralized timeline" },
};
---

<Section
  id="work"
  number="03"
  kicker="Open Source & Architecture"
  title="Selected Projects"
  subtitle="Open-source React Native modules and client applications built with C++ JSI and modern web standards."
>
  <!-- Card-free Open Editorial Spread -->
  <div class="space-y-12 sm:space-y-16 font-sans">
    {projects.map((project, idx) => {
      const visual = projectVisuals[project.title];
      return (
        <article class="pt-8 border-t border-neutral-200 dark:border-neutral-800 first:border-t-0 first:pt-0 group">
          <div class="grid lg:grid-cols-12 gap-6 lg:gap-10 items-start">
            <!-- Left Editorial Art Column (Real Graphic Illustration) -->
            {visual && (
              <div class="lg:col-span-2 hidden lg:flex flex-col items-center justify-start pt-2 select-none">
                <Image
                  src={visual.image}
                  alt={visual.alt}
                  width={120}
                  height={130}
                  quality={90}
                  class="w-20 lg:w-24 h-auto object-contain filter drop-shadow-[0_8px_16px_rgba(0,0,0,0.12)] dark:drop-shadow-[0_8px_20px_rgba(0,0,0,0.5)] transform -rotate-3 group-hover:rotate-2 group-hover:scale-105 transition-all duration-300"
                />
              </div>
            )}

            <!-- Main Content Column -->
            <div class:list={[visual ? "lg:col-span-10" : "lg:col-span-12", "space-y-4"]}>
              <!-- Header -->
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 pb-1">
                <div>
                  <div class="flex items-center gap-3">
                    <h3 class="font-serif text-3xl sm:text-4xl font-normal text-neutral-950 dark:text-white tracking-tight">
                      {project.title}
                    </h3>
                    <span class="text-xs font-mono text-neutral-500">
                      / {project.subtitle}
                    </span>
                  </div>
                  <p class="text-xs font-mono text-neutral-500 mt-0.5">
                    {project.tag}
                  </p>
                </div>

                <div class="text-xs font-mono text-neutral-500">
                  <span>{project.date}</span>
                </div>
              </div>

              <!-- Description Narrative -->
              <p class="text-sm sm:text-base text-neutral-700 dark:text-neutral-300 leading-relaxed font-sans max-w-4xl">
                {project.blurb}
              </p>

              <!-- Install Command Bar (Clean hairline terminal style) -->
              {project.install && (
                <div class="pt-1">
                  <button
                    type="button"
                    data-copy={project.install}
                    class="inline-flex items-center gap-2 px-3 py-1.5 rounded border border-neutral-200 dark:border-neutral-800 bg-neutral-100/60 dark:bg-neutral-900/60 hover:border-neutral-400 dark:hover:border-neutral-600 text-xs font-mono text-neutral-800 dark:text-neutral-200 cursor-pointer transition-colors group/btn"
                    title="Click to copy install command"
                  >
                    <span class="text-orange-600 dark:text-orange-500 font-bold select-none">$</span>
                    <span>{project.install}</span>
                    <span class="copy-icon inline-flex items-center text-neutral-400 group-hover/btn:text-orange-500">
                      <Copy class="size-3 copy-default" />
                      <Check class="size-3 text-emerald-500 copy-success hidden" />
                    </span>
                  </button>
                </div>
              )}

              <!-- Stack & Links Row -->
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-3 border-t border-neutral-100 dark:border-neutral-800/80 text-xs font-mono">
                <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-neutral-500">
                  <span class="text-[10px] uppercase tracking-wider text-neutral-400 font-semibold mr-1">Stack:</span>
                  {project.stack.map((item, i) => (
                    <>
                      <span class="text-neutral-700 dark:text-neutral-300 hover:text-orange-600 dark:hover:text-orange-400 transition-colors">
                        {item}
                      </span>
                      {i < project.stack.length - 1 && (
                        <span class="text-neutral-300 dark:text-neutral-700 select-none">·</span>
                      )}
                    </>
                  ))}
                </div>

                <div class="flex items-center gap-4 shrink-0">
                  {project.links.map((link) => (
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noopener"
                      class="inline-flex items-center gap-1 text-neutral-900 hover:text-orange-600 dark:text-neutral-200 dark:hover:text-orange-400 underline underline-offset-4 decoration-neutral-300 dark:decoration-neutral-700 transition-colors"
                    >
                      <span>{link.label}</span>
                      <ArrowUpRight class="size-3 text-neutral-400" />
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </article>
      );
    })}
  </div>
</Section>
