---
import Section from "./Section.astro";
import { projects } from "../data";
import StickerComponent from "./Sticker.astro";
import { ArrowUpRight, Copy, Check, Dot } from "lucide-astro";
import { stickers } from "../data/stickers";

const projectStickers: Record<string, { primary: keyof typeof stickers; secondary?: keyof typeof stickers; badge: string }> = {
  "rn-udpb": { primary: "crown", secondary: "knight", badge: "npm Package · C++ Nitro" },
  "Cosmos": { primary: "moon", secondary: "einstein", badge: "Open Source · Mastodon" },
};
---

<Section
  id="work"
  number="03"
  kicker="Open Source & Architecture"
  title="Selected Projects"
  subtitle="Open-source React Native modules and client applications built with C++ JSI and modern web standards."
>
  <!-- Card-free Open Editorial Spread -->
  <div class="space-y-12 sm:space-y-16 font-sans">
    {projects.map((project, idx) => {
      const visual = projectStickers[project.title];
      return (
        <article class="pt-8 border-t border-neutral-200 dark:border-neutral-800 first:border-t-0 first:pt-0 group">
          <div class="grid lg:grid-cols-12 gap-6 lg:gap-12 items-start">
            <!-- Left Column: Title, Subtitle, Date & Physical Sticker Stamps -->
            <div class="lg:col-span-5 space-y-3">
              <div class="flex items-center justify-between text-xs font-mono text-neutral-400">
                <span class="text-orange-600 dark:text-orange-400 font-semibold uppercase tracking-wider">
                  0{idx + 1} · {project.date}
                </span>
                <span>{project.tag}</span>
              </div>

              <div class="flex items-start justify-between gap-3">
                <div>
                  <h3 class="font-serif text-3xl sm:text-4xl font-normal text-neutral-950 dark:text-white tracking-tight">
                    {project.title}
                  </h3>
                  <p class="text-sm font-mono text-neutral-500 mt-1">
                    / {project.subtitle}
                  </p>
                </div>

                <!-- Halftone Sticker Stamp Accents (Integrated directly on the page) -->
                {visual && (
                  <div class="flex items-center -space-x-3 shrink-0 pt-1 select-none">
                    {visual.secondary && (
                      <div class="transform -rotate-12 group-hover:-translate-x-1 group-hover:rotate-0 transition-transform duration-300">
                        <StickerComponent name={visual.secondary} size="xs" interactive={true} />
                      </div>
                    )}
                    <div class="transform rotate-6 group-hover:scale-115 group-hover:rotate-12 transition-transform duration-300 z-10">
                      <StickerComponent name={visual.primary} size="sm" interactive={true} />
                    </div>
                  </div>
                )}
              </div>

              <!-- Links -->
              <div class="flex items-center gap-4 pt-2 font-mono text-xs">
                {project.links.map((link) => (
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener"
                    class="inline-flex items-center gap-1 text-neutral-800 hover:text-orange-600 dark:text-neutral-200 dark:hover:text-orange-400 underline underline-offset-4 decoration-neutral-300 dark:decoration-neutral-700 transition-colors"
                  >
                    <span>{link.label}</span>
                    <ArrowUpRight class="size-3 text-neutral-400" />
                  </a>
                ))}
              </div>
            </div>

            <!-- Right Column: Description Narrative, Terminal Bar & Stack Catalog -->
            <div class="lg:col-span-7 space-y-4">
              <p class="text-sm sm:text-base text-neutral-700 dark:text-neutral-300 leading-relaxed font-sans">
                {project.blurb}
              </p>

              <!-- Install Command Bar (Clean hairline terminal style) -->
              {project.install && (
                <div class="pt-1">
                  <button
                    type="button"
                    data-copy={project.install}
                    class="inline-flex items-center gap-2 px-3 py-1.5 rounded border border-neutral-200 dark:border-neutral-800 bg-neutral-100/60 dark:bg-neutral-900/60 hover:border-neutral-400 dark:hover:border-neutral-600 text-xs font-mono text-neutral-800 dark:text-neutral-200 cursor-pointer transition-colors group/btn"
                    title="Click to copy install command"
                  >
                    <span class="text-orange-600 dark:text-orange-500 font-bold select-none">$</span>
                    <span>{project.install}</span>
                    <span class="copy-icon inline-flex items-center text-neutral-400 group-hover/btn:text-orange-500">
                      <Copy class="size-3 copy-default" />
                      <Check class="size-3 text-emerald-500 copy-success hidden" />
                    </span>
                  </button>
                </div>
              )}

              <!-- Tech Stack Tags -->
              <div class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-xs text-neutral-500 pt-2 border-t border-neutral-100 dark:border-neutral-800/80">
                <span class="text-[10px] uppercase tracking-wider text-neutral-400 font-semibold mr-1">Stack:</span>
                {project.stack.map((item, i) => (
                  <>
                    <span class="text-neutral-700 dark:text-neutral-300 hover:text-orange-600 dark:hover:text-orange-400 transition-colors">
                      {item}
                    </span>
                    {i < project.stack.length - 1 && (
                      <span class="text-neutral-300 dark:text-neutral-700 select-none">·</span>
                    )}
                  </>
                ))}
              </div>
            </div>
          </div>
        </article>
      );
    })}
  </div>
</Section>
