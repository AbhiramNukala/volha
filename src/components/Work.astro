---
import Section from "./Section.astro";
import { projects } from "../data";
import { ArrowUpRight, Copy, Check, Dot } from "lucide-astro";
---

<Section
  id="work"
  number="03"
  kicker="Open Source & Projects"
  title="Selected Projects"
  subtitle="Open-source React Native modules and applications built with C++ JSI and modern web standards."
>
  <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 font-sans">
    {projects.map((project) => (
      <article class="space-y-4 pt-4 border-t border-neutral-200 dark:border-neutral-800 flex flex-col justify-between">
        <div class="space-y-3">
          <!-- Header -->
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 pb-1">
            <div>
              <div class="flex items-baseline gap-2">
                <h3 class="font-serif text-2xl sm:text-3xl font-normal text-neutral-950 dark:text-white tracking-tight">
                  {project.title}
                </h3>
                <span class="text-xs font-mono text-neutral-500">
                  / {project.subtitle}
                </span>
              </div>
              <p class="text-xs font-mono text-neutral-500 mt-0.5">
                {project.tag}
              </p>
            </div>

            <div class="text-xs font-mono text-neutral-500">
              <span>{project.date}</span>
            </div>
          </div>

          <!-- Description -->
          <p class="text-xs sm:text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed">
            {project.blurb}
          </p>

          <!-- Command (if installable) -->
          {project.install && (
            <div class="pt-1">
              <button
                type="button"
                data-copy={project.install}
                class="inline-flex items-center gap-2 px-2.5 py-1 rounded border border-neutral-200 dark:border-neutral-800 bg-neutral-100 dark:bg-neutral-900 text-xs font-mono text-neutral-800 dark:text-neutral-200 hover:border-neutral-300 dark:hover:border-neutral-700 transition-colors cursor-pointer group"
                title="Click to copy install command"
              >
                <span class="text-orange-600 dark:text-orange-500 select-none">$</span>
                <span>{project.install}</span>
                <span class="copy-icon inline-flex items-center text-neutral-400 group-hover:text-orange-500">
                  <Copy class="size-3 copy-default" />
                  <Check class="size-3 text-emerald-500 copy-success hidden" />
                </span>
              </button>
            </div>
          )}
        </div>

        <!-- Stack & Links -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-3 border-t border-neutral-100 dark:border-neutral-800/80 text-xs">
          <div class="flex items-center gap-1 font-mono text-neutral-500 flex-wrap">
            {project.stack.map((item, idx) => (
              <>
                <span>{item}</span>
                {idx < project.stack.length - 1 && (
                  <Dot class="size-3 -mx-1 text-neutral-400 dark:text-neutral-600 shrink-0" />
                )}
              </>
            ))}
          </div>

          <div class="flex items-center gap-3 font-mono">
            {project.links.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-0.5 text-neutral-800 hover:text-orange-600 dark:text-neutral-200 dark:hover:text-orange-400 underline underline-offset-4 decoration-neutral-300 dark:decoration-neutral-700 transition-colors"
              >
                <span>{link.label}</span>
                <ArrowUpRight class="size-3 text-neutral-400" />
              </a>
            ))}
          </div>
        </div>
      </article>
    ))}
  </div>
</Section>
