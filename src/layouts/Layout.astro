---
import "../styles/global.css";
import AuroraBackground from "../components/AuroraBackground.astro";
import { personal, links } from "../data";
import fontInter from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";
import fontInstrumentSerif from "@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url";
import fontInstrumentSerifItalic from "@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url";

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  noindex?: boolean;
}

const {
  title: pageTitle,
  description: pageDescription,
  canonicalUrl: propCanonicalUrl,
  image: pageImage,
  type = "website",
  publishedTime,
  modifiedTime,
  tags = [],
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site?.href ? Astro.site.href.replace(/\/$/, "") : "https://abhiramnukala.netlify.app";
const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "";

const defaultTitle = `${personal.name} — ${personal.title}`;
const title = pageTitle
  ? pageTitle.includes(personal.name)
    ? pageTitle
    : `${pageTitle} — ${personal.name}`
  : defaultTitle;

const defaultDescription = "Software Engineer specializing in React.js web apps and React Native iOS/Android apps with TypeScript & C++ JSI. Explore projects, architecture, and technical writings.";
const description = pageDescription || defaultDescription;

// Ensure trailing slash consistency with Astro site config
const path = Astro.url.pathname.endsWith("/") || Astro.url.pathname.includes(".")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalUrl = propCanonicalUrl || new URL(path, siteUrl).href;

const ogImage = pageImage
  ? new URL(pageImage, siteUrl).href
  : new URL("/og-image.png", siteUrl).href;

const jsonLdGraph: any[] = [
  {
    "@type": "Person",
    "@id": `${siteUrl}/#person`,
    name: personal.name,
    jobTitle: personal.title,
    description: personal.summary,
    url: `${siteUrl}/`,
    image: new URL("/og-image.png", siteUrl).href,
    email: `mailto:${personal.email}`,
    address: {
      "@type": "PostalAddress",
      addressLocality: "Hyderabad",
      addressRegion: "Telangana",
      addressCountry: "IN",
    },
    worksFor: {
      "@type": "Organization",
      name: "Mindwave AI Solutions",
    },
    sameAs: [links.github, links.linkedin, links.npm],
    knowsAbout: [
      "React Native",
      "React.js",
      "TypeScript",
      "JavaScript",
      "C++",
      "JSI",
      "Nitro Modules",
      "Expo",
      "Hermes Engine",
      "Redux Toolkit",
      "RTK Query",
      "Role-Based Access Control",
      "Cashfree",
    ],
  },
  {
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    url: `${siteUrl}/`,
    name: personal.name,
    description: defaultDescription,
    publisher: {
      "@id": `${siteUrl}/#person`,
    },
    inLanguage: "en-US",
  },
];

if (isHome) {
  jsonLdGraph.push({
    "@type": "ProfilePage",
    "@id": `${canonicalUrl}#profilepage`,
    url: canonicalUrl,
    name: title,
    description,
    isPartOf: {
      "@id": `${siteUrl}/#website`,
    },
    mainEntity: {
      "@id": `${siteUrl}/#person`,
    },
  });
} else if (type === "article") {
  jsonLdGraph.push(
    {
      "@type": "BlogPosting",
      "@id": `${canonicalUrl}#article`,
      headline: pageTitle || title,
      description,
      image: ogImage,
      datePublished: publishedTime,
      dateModified: modifiedTime || publishedTime,
      author: {
        "@id": `${siteUrl}/#person`,
      },
      publisher: {
        "@id": `${siteUrl}/#person`,
      },
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": canonicalUrl,
      },
      inLanguage: "en-US",
      keywords: tags.length > 0 ? tags.join(", ") : undefined,
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${siteUrl}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Blog",
          item: `${siteUrl}/blog/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: pageTitle || title,
          item: canonicalUrl,
        },
      ],
    }
  );
} else {
  jsonLdGraph.push(
    {
      "@type": "CollectionPage",
      "@id": `${canonicalUrl}#collection`,
      url: canonicalUrl,
      name: title,
      description,
      isPartOf: {
        "@id": `${siteUrl}/#website`,
      },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${siteUrl}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Blog",
          item: canonicalUrl,
        },
      ],
    }
  );
}

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": jsonLdGraph,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=5.0"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={personal.name} />
    <meta
      name="keywords"
      content="Nukala Abhiram, React.js, React Native, TypeScript, C++, JSI, Nitro Modules, Expo, Hyderabad, India"
    />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- Preload Critical Above-The-Fold Fonts -->
    <link
      rel="preload"
      href={fontInter}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={fontInstrumentSerif}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={fontInstrumentSerifItalic}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={personal.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content={ogImage.endsWith(".webp") ? "image/webp" : "image/png"} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    {type === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {type === "article" && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {type === "article" && (
      <meta property="article:author" content={personal.name} />
    )}
    {type === "article" && tags.map((t) => (
      <meta property="article:tag" content={t} />
    ))}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Color Scheme & Theme Color for Native Browser Chrome -->
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafaf9" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0c0d11" />
    <meta name="theme-color" content="#fafaf9" id="meta-theme-color" />

    <!-- Favicon & Touch Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd)}
    />

    <!-- Theme Initializer -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem("theme");
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          const meta = document.getElementById("meta-theme-color");
          if (stored === "dark" || (!stored && prefersDark)) {
            document.documentElement.classList.add("dark");
            if (meta) meta.setAttribute("content", "#0c0d11");
          } else {
            document.documentElement.classList.remove("dark");
            if (meta) meta.setAttribute("content", "#fafaf9");
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="bg-[#fafaf9] dark:bg-[#0c0d11] text-neutral-900 dark:text-neutral-100 antialiased min-h-screen flex flex-col font-sans selection:bg-orange-500/20 selection:text-orange-700 dark:selection:bg-orange-500/30 dark:selection:text-orange-300 relative">
    <!-- Animated Orange Aurora Atmosphere -->
    <AuroraBackground />

    <!-- Tactile Background Film Grain -->
    <div class="fixed inset-0 pointer-events-none select-none z-[1] bg-noise" aria-hidden="true"></div>

    <!-- Site Content Layer -->
    <div class="relative z-10 flex flex-col min-h-screen">
      <slot />
    </div>

    <!-- Minimalist Toast notification -->
    <div
      id="global-toast"
      class="rounded-lg border border-neutral-300 dark:border-neutral-800 bg-white/95 dark:bg-neutral-900/95 px-3.5 py-2 text-xs text-neutral-800 dark:text-neutral-200 font-mono shadow-xl backdrop-blur-md flex items-center gap-2"
    >
      <span class="size-1.5 rounded-full bg-emerald-500"></span>
      <span id="toast-message">Copied</span>
    </div>

    <script is:inline>
      // Theme toggle helper
      window.toggleTheme = function () {
        const isDark = document.documentElement.classList.toggle("dark");
        try {
          localStorage.setItem("theme", isDark ? "dark" : "light");
          const meta = document.getElementById("meta-theme-color");
          if (meta) meta.setAttribute("content", isDark ? "#0c0d11" : "#fafaf9");
        } catch (_) {}
      };

      document.getElementById("theme-toggle-desktop")?.addEventListener("click", window.toggleTheme);
      document.getElementById("theme-toggle-mobile")?.addEventListener("click", window.toggleTheme);

      // Mobile nav drawer
      const toggleBtn = document.getElementById("mobile-nav-toggle");
      const menu = document.getElementById("mobile-nav-menu");
      const iconOpen = document.getElementById("menu-icon-open");
      const iconClose = document.getElementById("menu-icon-close");

      if (toggleBtn && menu) {
        toggleBtn.addEventListener("click", () => {
          const isHidden = menu.classList.contains("hidden");
          if (isHidden) {
            menu.classList.remove("hidden");
            menu.classList.add("flex");
            iconOpen?.classList.add("hidden");
            iconClose?.classList.remove("hidden");
            toggleBtn.setAttribute("aria-expanded", "true");
          } else {
            menu.classList.add("hidden");
            menu.classList.remove("flex");
            iconOpen?.classList.remove("hidden");
            iconClose?.classList.add("hidden");
            toggleBtn.setAttribute("aria-expanded", "false");
          }
        });

        document.querySelectorAll(".mobile-nav-link").forEach((link) => {
          link.addEventListener("click", () => {
            menu.classList.add("hidden");
            menu.classList.remove("flex");
            iconOpen?.classList.remove("hidden");
            iconClose?.classList.add("hidden");
            toggleBtn.setAttribute("aria-expanded", "false");
          });
        });
      }

      // Toast notification helper
      let toastTimer = null;
      window.showToast = function (msg) {
        const toast = document.getElementById("global-toast");
        const msgEl = document.getElementById("toast-message");
        if (!toast || !msgEl) return;
        msgEl.textContent = msg;
        toast.classList.add("show");
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          toast.classList.remove("show");
        }, 2000);
      };

      // Global copy helper
      document.addEventListener("click", async (e) => {
        const copyBtn = e.target.closest?.("[data-copy]");
        if (!copyBtn) return;
        const text = copyBtn.getAttribute("data-copy");
        if (!text) return;
        try {
          await navigator.clipboard.writeText(text);
          window.showToast(`Copied: ${text.length > 24 ? text.slice(0, 20) + "..." : text}`);

          const icon = copyBtn.querySelector(".copy-icon");
          if (icon) {
            const def = icon.querySelector(".copy-default");
            const succ = icon.querySelector(".copy-success");
            if (def && succ) {
              def.classList.add("hidden");
              succ.classList.remove("hidden");
              setTimeout(() => {
                def.classList.remove("hidden");
                succ.classList.add("hidden");
              }, 1600);
            }
          }
        } catch {
          window.showToast("Failed to copy");
        }
      });

      // Active Section Navigation Observer
      const sections = document.querySelectorAll("section[id]");
      const navLinks = document.querySelectorAll(".nav-anchor");
      if ("IntersectionObserver" in window && sections.length > 0) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const id = entry.target.getAttribute("id");
                navLinks.forEach((link) => {
                  const href = link.getAttribute("href");
                  if (href && (href === `#${id}` || href.endsWith(`/#${id}`) || href.endsWith(`#${id}`))) {
                    link.classList.add("text-orange-600", "dark:text-orange-400", "font-medium");
                  } else {
                    link.classList.remove("text-orange-600", "dark:text-orange-400", "font-medium");
                  }
                });
              }
            });
          },
          { rootMargin: "-20% 0px -60% 0px" }
        );
        sections.forEach((sec) => observer.observe(sec));
      }
    </script>
  </body>
</html>
