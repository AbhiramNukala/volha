---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import CommandPalette from "../../components/CommandPalette.astro";
import ScrollToTop from "../../components/ScrollToTop.astro";
import { getCollection } from "astro:content";
import { Calendar, Clock, ArrowRight, ArrowLeft } from "lucide-astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

function formatDate(d: Date) {
  return d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}
---

<Layout>
  <CommandPalette />
  <Nav />

  <main class="w-full flex-1 pt-3 sm:pt-4 pb-16 font-sans">
    <div class="w-full max-w-5xl mx-auto px-6 sm:px-10 lg:px-16">
      <!-- Back Link -->
      <div class="mb-1.5 sm:mb-2">
        <a
          href="/"
          class="inline-flex items-center gap-1.5 text-xs font-mono text-neutral-500 hover:text-orange-600 dark:hover:text-orange-400 transition-colors group"
        >
          <ArrowLeft class="size-3.5 group-hover:-translate-x-1 transition-transform" />
          <span>Back to Portfolio</span>
        </a>
      </div>

      <!-- Page Header -->
      <div class="space-y-2 sm:space-y-2.5 pb-6 border-b border-neutral-200 dark:border-neutral-800">
        <h1 class="font-serif text-4xl sm:text-6xl font-normal text-neutral-950 dark:text-white leading-[1.08] tracking-tight">
          Brain Dumps, Bugs &amp;{" "}
          <span class="italic text-orange-600 dark:text-orange-400 aurora-text-gradient">
            Accidental Features
          </span>
        </h1>

        <p class="text-base sm:text-lg text-neutral-700 dark:text-neutral-300 max-w-2xl leading-relaxed">
          A collection of 2 AM epiphanies, C++ memory leaks, questionable architectural choices, and things that somehow worked on my machine before being unleashed into production.
        </p>
      </div>

      <!-- Articles Stream or Empty State -->
      {posts.length > 0 ? (
        <div class="divide-y divide-neutral-200 dark:divide-neutral-800">
          {posts.map((post) => (
            <article class="py-7 sm:py-9 group transition-all">
              <div class="space-y-3">
                <!-- Meta Row: Date, Reading Time -->
                <div class="flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-xs text-neutral-500">
                  <span class="inline-flex items-center gap-1.5">
                    <Calendar class="size-3.5 text-neutral-400" />
                    <time datetime={post.data.pubDate.toISOString()}>
                      {formatDate(post.data.pubDate)}
                    </time>
                  </span>

                  {post.data.readingTime && (
                    <span class="inline-flex items-center gap-1.5">
                      <Clock class="size-3.5 text-neutral-400" />
                      <span>{post.data.readingTime}</span>
                    </span>
                  )}

                  {post.data.featured && (
                    <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold uppercase tracking-wider bg-orange-100 text-orange-700 dark:bg-orange-500/20 dark:text-orange-300">
                      Featured
                    </span>
                  )}
                </div>

                <!-- Title Link -->
                <h2 class="font-serif text-2xl sm:text-3xl font-normal text-neutral-950 dark:text-white tracking-tight leading-snug group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-colors">
                  <a href={`/blog/${post.id}`} class="block">
                    {post.data.title}
                  </a>
                </h2>

                <!-- Description -->
                <p class="text-sm sm:text-base text-neutral-700 dark:text-neutral-300 leading-relaxed font-sans max-w-3xl">
                  {post.data.description}
                </p>

                <!-- Read Article Action -->
                <div class="pt-1">
                  <a
                    href={`/blog/${post.id}`}
                    class="inline-flex items-center gap-1 text-xs font-mono font-medium text-orange-600 hover:text-orange-700 dark:text-orange-400 dark:hover:text-orange-300 group-hover:translate-x-1 transition-all"
                  >
                    <span>Read Article</span>
                    <ArrowRight class="size-3.5" />
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="py-16 sm:py-24 text-center space-y-3 font-sans">
          <p class="font-serif text-2xl sm:text-3xl text-neutral-900 dark:text-neutral-100 font-normal">
            No blogs in yet, hope they will be added soon!
          </p>
          <p class="text-xs sm:text-sm font-mono text-neutral-500">
            Check back later for upcoming technical articles and engineering notes.
          </p>
        </div>
      )}
    </div>
  </main>

  <Footer />
  <ScrollToTop />
</Layout>
